<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Gallery.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf.Ui.Gallery.Views.Pages.DateAndTime"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="Wpf.Ui.Gallery.Views.Pages.DateAndTime.TimePickerPage"
    Title="TimePickerPage"
    controls:PageControlDocumentation.DocumentationType="{x:Type ui:TimePicker}"
    d:DataContext="{d:DesignInstance local:TimePickerPage,                                      IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <StackPanel Margin="0,0,0,24">
        <controls:ControlExample
            Margin="0"
            HeaderText="WPF UI TimePicker."
            XamlCode='&lt;ui:TimePicker ClockIdentifier="Clock24Hour" /&gt;'>
            <ui:TimePicker
                Width="300"
                AcceptButtonText="OK"
                DismissButtonText="Cancel"
                HorizontalAlignment="Left"
                ClockIdentifier="Clock24Hour" />
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="12-hour clock"
            XamlCode='&lt;ui:TimePicker ClockIdentifier="Clock12Hour" /&gt;'>
            <ui:TimePicker Width="300" HorizontalAlignment="Left" ClockIdentifier="Clock12Hour" />
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Midnight is a selected time"
            XamlCode='&lt;ui:TimePicker ClockIdentifier="Clock12Hour" SelectedTime="00:00:00" /&gt;'>
            <ui:TimePicker
                Width="300"
                HorizontalAlignment="Left"
                ClockIdentifier="Clock12Hour"
                SelectedTime="00:00:00" />
        </controls:ControlExample>
        <controls:ControlExample
            Margin="0,24,0,0"
            HeaderText="Disabled time picker"
            XamlCode='&lt;ui:TimePicker IsEnabled="False" /&gt;'>
            <ui:TimePicker Width="300" HorizontalAlignment="Left" IsEnabled="False" />
        </controls:ControlExample>
    </StackPanel>
</Page>
